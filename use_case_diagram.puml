@startuml
left to right direction
actor "users" as users
actor "system" as system
actor "cust_service" as cust_service
rectangle "online shopping app" {
  usecase "Use case 1 - Add items to the cart" as Use_case_1___Add_items_to_the_cart
  usecase "Use case 2 - Search for category" as Use_case_2___Search_for_category
  usecase "Use case 3 - Monitors the users and system" as Use_case_3___Monitors_the_users_and_system
}
users --> Use_case_1___Add_items_to_the_cart
users --> Use_case_2___Search_for_category
cust_service --> Use_case_3___Monitors_the_users_and_system
@enduml
